# Local development settings for the Vouch frontend.
#
# WARNING: every variable that starts with VITE_ is bundled into the JavaScript
# that runs in the browser. Anyone who opens the page can read it in DevTools.
# NEVER put a production API key or any other real secret in this file.
#
# "dev-accountant-key" is the public development key built into vouch/api.py.
# The backend only accepts it when VOUCH_API_KEYS is not set (dev mode), and it
# is refused when VOUCH_ENV=prod. It makes the dashboard act as the accountant "ann".
#
# To use a different dev key on your machine only, put it in .env.development.local
# (ignored by git via the *.local rule in .gitignore).
VITE_VOUCH_API_KEY=dev-accountant-key
